# Prune the workspace to only include the web/ app and its dependencies
FROM node:24-alpine AS builder
RUN apk add --no-cache libc6-compat
WORKDIR /app
RUN npm install -g turbo@latest
COPY . .

RUN turbo prune --scope=web --docker

# Install the dependencies and build the web/ app
FROM node:24-alpine AS installer
RUN apk add --no-cache libc6-compat
WORKDIR /app

COPY --from=builder /app/out/json/ .
COPY --from=builder /app/out/package-lock.json ./
RUN npm ci

COPY --from=builder /app/out/full/ .

# Optimization
ENV NEX_TELEMETRY_DISABLED 1
ENV NODE_ENV production

RUN npx turbo run build --filter=web


# Run the web/ app in production mode
FROM node:24-alpine AS runner
WORKDIR /app

ENV NODE_ENV production
ENV NEX_TELEMETRY_DISABLED 1

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Copy standalone output & assets generated by Next.js
COPY --from=installer /app/apps/web/public ./apps/web/public
COPY --from=installer --chown=nextjs:nodejs /app/apps/web/.next/standalone ./
COPY --from=installer --chown=nextjs:nodejs /app/apps/web/.next/static ./apps/web/.next/static

USER nextjs

EXPOSE 5000

ENV PORT 5000
ENV HOSTNAME "0.0.0.0"

CMD ["node", "apps/web/server.js"]